{%- comment -%}
  Schema JSON-LD:
  - Home: Organization + WebSite graph
  - Collection: ItemList
  - Product: Product + variant-level Offers (shipping + return policy)
{%- endcomment -%}

{%- assign shop_url = shop.url -%}
{%- assign policy_url = shop.url | append: '/pages/exchange-policy' -%}

{%- if template.name == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization","OnlineStore"],
      "@id": {{ shop_url | append: "/#organization" | json }},
      "name": {{ shop.name | json }},
      "legalName": {{ shop.name | json }},
      "url": {{ shop_url | append: "/" | json }},
      {%- if settings.logo != blank -%}
      "logo": {{ settings.logo | image_url: width: 200 | prepend: "https:" | json }},
      {%- endif -%}
      "description": {{ shop.description | default: shop.name | strip_html | strip_newlines | json }},
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "telephone": {{ "+92 306 0412412" | json }},
          "email": {{ "help@iznikfashions.com" | json }},
          "areaServed": {{ "PK" | json }},
          "availableLanguage": ["en"]
        }
      ],
      "sameAs": [
        "https://www.instagram.com/iznikfashion/",
        "https://www.facebook.com/iznikfashion",
        "https://www.youtube.com/@iznikfashions9075",
        "https://www.pinterest.com/iznikfashion/",
        "https://www.tiktok.com/@iznikfashion",
        "https://wa.me/+923060412412"
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "10:00",
          "closes": "18:00"
        }
      ],
      "priceRange": {{ "PKR 7000-35000" | json }},
      "paymentAccepted": ["CashOnDelivery","Visa","MasterCard","UnionPay","BankAccount","EasyPaisa","JazzCash"],
      "hasMerchantReturnPolicy": {
        "@id": {{ policy_url | json }}
      }
    },
    {
      "@type": "WebSite",
      "@id": {{ shop_url | append: "/#website" | json }},
      "url": {{ shop_url | append: "/" | json }},
      "name": {{ shop.name | json }},
      "publisher": { "@id": {{ shop_url | append: "/#organization" | json }} },
      "inLanguage": "en-PK"
    }
  ]
}
</script>
{%- endif -%}

{%- if template.name == 'collection' and collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ collection.title | strip_html | json }},
  "url": {{ canonical_url | json }},
  "itemListOrder": "https://schema.org/ItemListOrderAscending",
  "numberOfItems": {{ collection.products_count | default: collection.products.size }},
  "itemListElement": [
    {%- for product in collection.products -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": {{ shop.url | append: product.url | json }},
        "name": {{ product.title | strip_html | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- if template.name == 'product' and product -%}
{%- assign price_valid_until = 'now' | date: '%s' | plus: 2592000 | date: '%Y-%m-%d' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ shop.url | append: product.url | json }},
  "name": {{ product.title | strip_html | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | default: product.handle | json }},
  "url": {{ canonical_url | json }},
  "image": [
    {%- for img in product.images -%}
      {{ img | image_url: width: 900 | prepend: "https:" | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "description": {{ product.description | strip_html | strip_newlines | json }},
  "brand": {"@type":"Brand","name": {{ product.vendor | default: shop.name | json }}},
  "offers": [
    {%- for v in product.variants -%}
      {%- assign is_stitched = false -%}
      {%- if v.title contains 'Stitched' or v.option1 contains 'Stitched' or v.option2 contains 'Stitched' or v.option3 contains 'Stitched' -%}
        {%- assign is_stitched = true -%}
      {%- endif -%}

      {
        "@type": "Offer",
        "name": {{ v.title | strip_html | json }},
        "url": {{ canonical_url | append: "?variant=" | append: v.id | json }},
        "priceCurrency": {{ cart.currency.iso_code | default: "PKR" | json }},
        "price": {{ v.price | money_without_currency | remove: "," | json }},
        "availability": {%- if v.available -%}"https://schema.org/InStock"{%- else -%}"https://schema.org/OutOfStock"{%- endif -%},
        "itemCondition": "https://schema.org/NewCondition",
        "priceValidUntil": {{ price_valid_until | json }},
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {"@type":"MonetaryAmount","value":0,"currency":"PKR"},
          "shippingDestination": {"@type":"DefinedRegion","addressCountry":"PK"},
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type":"QuantitativeValue",
              "minValue": {%- if is_stitched -%}30{%- else -%}1{%- endif -%},
              "maxValue": {%- if is_stitched -%}35{%- else -%}2{%- endif -%},
              "unitCode":"DAY"
            },
            "transitTime": {"@type":"QuantitativeValue","minValue":2,"maxValue":5,"unitCode":"DAY"}
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "PK",
          "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
          "description": "Exchange only within 7 days for domestic orders. No exchanges for international orders. See policy: {{ shop.url }}/pages/exchange-policy"
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
