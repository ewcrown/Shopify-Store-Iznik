{% comment %}
  Sleeve Style line-item property.

  Usage (place inside the product form for best results):
    {% render 'sleeve-style-selector' %}

  The product must have the tag "sleeve-style". Optional choices can be set with:
    - custom.sleeve_styles metafield (list of single-line text), or
    - a tag such as: sleeve-options:Cap Sleeves|Full Sleeves
{% endcomment %}

{%- if product and product.tags contains 'sleeve-style' -%}
  {%- liquid
    assign sleeve_options_tag = blank
    for product_tag in product.tags
      if product_tag contains 'sleeve-options:'
        assign sleeve_options_tag = product_tag | remove_first: 'sleeve-options:'
        break
      endif
    endfor

    assign sleeve_metafield = product.metafields.custom.sleeve_styles
    assign sleeve_instance_id = 'SleeveStyle-' | append: section.id | append: '-' | append: product.id
  -%}

  <div
    id="{{ sleeve_instance_id }}"
    class="sleeve-style-selector"
    data-sleeve-style-selector
    data-product-id="{{ product.id }}"
    hidden
  >
    <fieldset class="sleeve-style-selector__fieldset">
      <legend class="variant__label sleeve-style-selector__legend">Select Your Preferred Sleeve Style</legend>
      <div class="sleeve-style-selector__options">
        {%- if sleeve_options_tag != blank -%}
          {%- assign sleeve_options = sleeve_options_tag | split: '|' -%}
          {%- for sleeve_option in sleeve_options -%}
            {%- assign sleeve_option = sleeve_option | strip -%}
            {%- if sleeve_option != blank -%}
              <div class="sleeve-style-selector__option">
                <input id="{{ sleeve_instance_id }}-{{ forloop.index }}" type="radio" name="properties[Sleeve Style]" value="{{ sleeve_option | escape }}" disabled>
                <label class="variant__button-label" for="{{ sleeve_instance_id }}-{{ forloop.index }}">{{ sleeve_option | escape }}</label>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif sleeve_metafield != blank and sleeve_metafield.type contains 'list.' -%}
          {%- for sleeve_option in sleeve_metafield.value -%}
            {%- assign sleeve_option = sleeve_option | strip -%}
            {%- if sleeve_option != blank -%}
              <div class="sleeve-style-selector__option">
                <input id="{{ sleeve_instance_id }}-{{ forloop.index }}" type="radio" name="properties[Sleeve Style]" value="{{ sleeve_option | escape }}" disabled>
                <label class="variant__button-label" for="{{ sleeve_instance_id }}-{{ forloop.index }}">{{ sleeve_option | escape }}</label>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign sleeve_options = 'Short Sleeves|Full Sleeves' | split: '|' -%}
          {%- for sleeve_option in sleeve_options -%}
            <div class="sleeve-style-selector__option">
              <input id="{{ sleeve_instance_id }}-{{ forloop.index }}" type="radio" name="properties[Sleeve Style]" value="{{ sleeve_option | escape }}" disabled>
              <label class="variant__button-label" for="{{ sleeve_instance_id }}-{{ forloop.index }}">{{ sleeve_option }}</label>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </fieldset>
    <p class="sleeve-style-selector__error" role="alert" aria-live="polite" hidden>Please select a sleeve style.</p>
  </div>

  <style>
    #{{ sleeve_instance_id }} { margin: 20px 0; }
    #{{ sleeve_instance_id }}[hidden] { display: none !important; }
    #{{ sleeve_instance_id }} .sleeve-style-selector__fieldset { display: block; margin: 0; padding: 0; border: 0; }
    #{{ sleeve_instance_id }} .sleeve-style-selector__legend { display: block; width: 100%; margin: 0 0 10px; padding: 0; font-style: normal; }
    #{{ sleeve_instance_id }} .sleeve-style-selector__options { display: block; }
    #{{ sleeve_instance_id }} .sleeve-style-selector__option { display: flex; align-items: center; position: relative; margin: 0 0 8px; }
    #{{ sleeve_instance_id }} input[type="radio"] { display: inline-block; width: 16px; height: 16px; margin: 0 7px 0 0; opacity: 1; accent-color: #000; cursor: pointer; }
    #{{ sleeve_instance_id }} .variant__button-label {
      cursor: pointer;
      font-family: Montserrat, sans-serif;
      font-weight: 400;
      letter-spacing: normal !important;
      text-transform: none;
      display: inline;
      line-height: 1.4;
      padding: 0;
      font-size: inherit;
      font-style: normal;
      color: #222323;
      margin: 0;
    }
    #{{ sleeve_instance_id }} input[type="radio"]:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
    #{{ sleeve_instance_id }} .sleeve-style-selector__error { margin: 8px 0 0; color: #b42318; text-transform: none; }
  </style>

  <script>
    (function () {
      var root = document.getElementById({{ sleeve_instance_id | json }});
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      var section = root.closest('[data-section-type="product"], .shopify-section') || document;
      var form = root.closest('form[action*="/cart/add"]') ||
        section.querySelector('form[action*="/cart/add"]') ||
        document.querySelector('form.product-single__form[action*="/cart/add"]');
      var radios = Array.prototype.slice.call(root.querySelectorAll('input[type="radio"]'));
      var error = root.querySelector('.sleeve-style-selector__error');

      if (form && form.id && !root.closest('form')) {
        radios.forEach(function (radio) { radio.setAttribute('form', form.id); });
      }

      function selectedType() {
        var controls = section.querySelectorAll('[data-variant-input]:checked, .variant-input-wrap select');
        for (var i = 0; i < controls.length; i++) {
          var control = controls[i];
          var name = (control.name || '').toLowerCase();
          var value = (control.value || '').trim().toLowerCase();
          var wrapper = control.closest('.variant-input-wrap');
          var optionName = wrapper ? (wrapper.getAttribute('name') || '').toLowerCase() : '';
          if ((name === 'type' || optionName === 'type') && (value === 'stitched' || value === 'unstitched')) return value;
        }
        return '';
      }

      function updateVisibility() {
        var show = selectedType() === 'stitched';
        root.hidden = !show;
        radios.forEach(function (radio) {
          radio.disabled = !show;
          radio.required = show;
          if (!show) radio.checked = false;
        });
        if (!show) error.hidden = true;
      }

      function isValid() {
        if (root.hidden) return true;
        var checked = root.querySelector('input[type="radio"]:checked');
        error.hidden = !!checked;
        if (!checked) {
          root.scrollIntoView({ behavior: 'smooth', block: 'center' });
          radios[0] && radios[0].focus({ preventScroll: true });
          return false;
        }
        return true;
      }

      section.addEventListener('change', function (event) {
        if (event.target.matches('[data-variant-input], input[type="radio"], select')) updateVisibility();
        if (event.target.name === 'properties[Sleeve Style]') error.hidden = true;
      });
      document.addEventListener('variant:change', updateVisibility);
      if (form) form.addEventListener('submit', function (event) {
        if (!isValid()) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      }, true);
      section.addEventListener('click', function (event) {
        var submitControl = event.target.closest('[data-add-to-cart], #buy-now-btn, .shopify-payment-button__button');
        if (submitControl && !isValid()) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      }, true);

      updateVisibility();
    }());
  </script>
{%- endif -%}
