    <style>
      body {
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        font-family: Arial, sans-serif;
        margin: 0;
      }
      .background-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        border: none;
        align-items: center;
        justify-content: center;
        background-image: var(--def-background-img);
        background-color: var(--def-background);
        background-size: cover;
        background-attachment: fixed;
        background-position: center;
        background-repeat: no-repeat;
      }
      #openChatButton {
        display: flex;
        justify-content: center;
        align-item: center;
        min-width: 65px;
        max-width: 65px;
        min-height: 65px;
        max-height: 65px;
        border: none;
        cursor: pointer;
        position: fixed;
        bottom: 20px;
        right: 20px;
        display: block;
        z-index: 1000;
        border-radius: 100%;
        padding: 12px;
        background-color: #67C15E;
        color: white;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
        transition: background 0.3s;
      }
      #chat-container {
        display: none;
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 355px;
        height: 65vh;
        border: 1px solid #ccc;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        background-color: transparent;
        z-index: 1000;
        margin-bottom: 11vh;
      }
      #appFrame {
        width: 100%;
        height: 100%;
        border: none;
      }
      #loadingSpinner {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: none;
        width: 50px;
        height: 50px;
        border: 5px solid #f3f3f3;
        border-top: 5px solid #000000;
        border-radius: 40px;
        animation: spin 1s linear infinite;
      }
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      #closeChatButton {
        position: absolute;
        top: 16px;
        right: 16px;
        background-color: #dc656533;
        color: #dc6565;
        font-size: 20px;
        padding: 0 9px;
        border-radius: 50%;
        cursor: pointer;
        border: none;
      }
      .chat-icon {
        width: 34px;
        height: 34px;
      }  
    </style>

