<script>
fetch("https://api.country.is/")
  .then(res => res.json())
  .then(({ country }) => {
    // Skip redirect for Pakistani visitors or anyone already on the global site
    if (country === 'PK' || location.hostname.startsWith('global.')) return;

    // Preserve everything after the domain (path -> ?query -> #hash)
    const destination = 'https://global.iznikfashions.com' +
                        location.pathname +
                        location.search +
                        location.hash;

    // Use replace() so the original URL isn’t kept in browser history
    window.location.replace(destination);
  })
  .catch(console.error);     // fail silently if the geo-lookup ever errors
</script>

